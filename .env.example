# GODMODE++ Frontend – Environment Variables
#
# This is a vanilla-JS / no-build-tool PWA, so there is no build-time env
# injection.  Instead, set the API base URL at runtime by uncommenting the
# override script in index.html (just before the auth-utils.js <script> tag):
#
#   <script>window.GODMODE_API_BASE = "https://your-godmode-backend.com";</script>
#
# ──────────────────────────────────────────────────────────────────────────────

# GODMODE_API_BASE
#   The base URL of the godmode-backend FastAPI service.
#   Default (when not set): http://localhost:8000
#
# Local development:
#   GODMODE_API_BASE=http://localhost:8000
#
# Production (Render, Railway, Fly.io, etc.):
#   GODMODE_API_BASE=https://your-godmode-backend.onrender.com

GODMODE_API_BASE=http://localhost:8000
